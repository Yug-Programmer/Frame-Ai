# ============================================================
#  Qoneqt Content Engine — Environment Variables
#  Copy this file to server/.env and fill in your credentials
# ============================================================

# ── LLM: GroqCloud (required for AI generation) ─────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Available models: llama-3.3-70b-versatile | mixtral-8x7b-32768 | llama3-8b-8192
GROQ_MODEL=llama-3.3-70b-versatile

# ── Voice: ElevenLabs (required for AI voice narration) ─────
# Get your key at: https://elevenlabs.io/app/speech-synthesis
ELEVENLABS_API_KEY=
# Voice ID — Rachel (default). Browse voices: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Model: eleven_multilingual_v2 | eleven_monolingual_v1 | eleven_turbo_v2
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Visual Generation ────────────────────────────────────────
# Leave VISUAL_PROVIDER=canvas for built-in 1080x1920 compositor
# (no API key needed for canvas)
VISUAL_PROVIDER=canvas
VISUAL_API_KEY=

# ── Server Runtime ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Set to true to skip API calls and use mock data (for UI testing)
DEV_MOCK_MODE=false

# ── FFmpeg Binary ────────────────────────────────────────────
# Leave blank to auto-detect from PATH or WinGet packages
FFMPEG_PATH=
